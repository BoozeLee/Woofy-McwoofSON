# 🐾 Example environment variables for WOOFY McWOOFSON

# Local webhook server (main.py)
PORT=8080
# 127.0.0.1 = local only (default). Set 0.0.0.0 only behind a trusted ingress.
HOST=127.0.0.1
LOG_LEVEL=info

# GitHub webhook verification (required by main.py)
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=your-webhook-secret

# GitHub API (used by the autonomous scheduler for event queries)
GITHUB_TOKEN=

# AWS / Lambda (deployment only)
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
API_GATEWAY_URL=https://your-api-gateway-url